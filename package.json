{
  "name": "@xenra/dsh-draworld",
  "version": "0.1.35",
  "private": true,
  "description": "星染世界：DeepSeek Harness 里的一块真画布: a right-sidebar canvas tab plus a paint_canvas tool, so the model and the human draw on the same document.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RUO-MO/dsh-draworld.git"
  },
  "homepage": "https://github.com/RUO-MO/dsh-draworld#readme",
  "bugs": {
    "url": "https://github.com/RUO-MO/dsh-draworld/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "canvas",
    "painting",
    "paint_canvas"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "version:bump": "node tools/bump-version.mjs",
    "version:watch": "node tools/watch-version.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "pixels.js",
    "pixelops.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
